{
  "name": "workbench-report-check",
  "private": true,
  "description": "Confirms that a Workbench bug report reached Sentry with every attachment intact.",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.check.json",
    "test:ops": "python3 -m unittest discover -s ops -p 'test_*.py'"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "typescript": "6.0.3"
  }
}
