{
  "regressions": [
    "bash",
    "scripts/test.sh"
  ],
  "build": [
    "bash",
    "scripts/build.sh",
    "--component-package"
  ],
  "archive": "dist/Workbench.zip",
  "bundle": "Workbench.app",
  "identifier": "com.ethdawg.workbench",
  "executable": "Workbench",
  "entitlements": "scripts/release/developer-id.plist",
  "checks": [
    [
      "--check-core"
    ],
    [
      "--check-input"
    ],
    [
      "--self-test"
    ],
    [
      "--check-presenter"
    ],
    [
      "--check-readback"
    ],
    [
      "--check-readback-resources"
    ],
    [
      "--check-readback-pack",
      "--check-transcript-handoff"
    ],
    [
      "--check-reading-service-native"
    ]
  ],
  "component_archive": ".build/component/Workbench.zip"
}
