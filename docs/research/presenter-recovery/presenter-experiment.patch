diff --git a/BrowserExtension/bookmarks.js b/BrowserExtension/bookmarks.js
new file mode 100644
index 0000000..9bf711f
--- /dev/null
+++ b/BrowserExtension/bookmarks.js
@@ -0,0 +1,122 @@
+import { WorkbenchError } from "./core.js";
+
+export function validBookmarkID(value) {
+  return typeof value === "string" && /^[a-zA-Z0-9_-]{1,128}$/.test(value);
+}
+
+// Bookmark navigation preserves its full original address inside Chrome.
+// This function is intentionally separate from saved-destination canonicalization.
+export function bookmarkURL(value) {
+  if (typeof value !== "string" || new TextEncoder().encode(value).length > 4096
+      || !/^https?:\/\/[^/?#]+/i.test(value) || /[\s\u0000-\u001f\u007f\\]/u.test(value)) throw new WorkbenchError("bookmarkURL");
+  let url;
+  try { url = new URL(value); } catch { throw new WorkbenchError("bookmarkURL"); }
+  const authority = value.slice(value.indexOf("//") + 2).split(/[/?#]/, 1)[0];
+  if (!url.hostname || authority.includes("@") || url.username || url.password
+      || !["http:", "https:"].includes(url.protocol) || new TextEncoder().encode(url.href).length > 4096) throw new WorkbenchError("bookmarkURL");
+  return url;
+}
+
+export function bookmarkSummary(bookmark) {
+  if (!bookmark || !validBookmarkID(bookmark.id)) return null;
+  let url;
+  try { url = bookmarkURL(bookmark.url); } catch { return null; }
+  // Bookmarks remain Chrome-owned. Titles are treated as untrusted text, not
+  // instructions, and reduced to an audience-safe display label.
+  const label = String(bookmark.title ?? "").replace(/https?:\/\/[^\s]+/giu, match => {
+    try { return bookmarkURL(match).hostname; } catch { return "Website"; }
+  }).replace(/[\u0000-\u001f\u007f\u202a-\u202e\u2066-\u2069]/gu, " ").replace(/\s+/gu, " ").trim();
+  const title = [...(label || url.hostname)].slice(0, 80).join("");
+  return { id: bookmark.id, title, host: url.host };
+}
+
+export class BookmarkController {
+  constructor(api, { now = Date.now, timeoutMS = 8_000 } = {}) {
+    this.api = api;
+    this.now = now;
+    this.timeoutMS = timeoutMS;
+    this.generation = 0;
+    this.busy = false;
+  }
+
+  cancel() { this.generation++; }
+
+  async access() {
+    try { return await this.api.permissions.contains({ permissions: ["bookmarks"] }); }
+    catch { return false; }
+  }
+
+  async search(query = "") {
+    if (typeof query !== "string" || [...query].length > 80 || /[\u0000-\u001f\u007f]/u.test(query)) throw new WorkbenchError("invalidMessage");
+    const generation = this.generation;
+    if (!await this.access()) return { ok: false, error: "bookmarkPermission", bookmarks: [], bookmarkAccess: false };
+    try {
+      const nodes = query.trim() ? await this.api.bookmarks.search({ query: query.trim() }) : await this.api.bookmarks.getRecent(30);
+      if (!await this.access()) return { ok: false, error: "bookmarkPermission", bookmarks: [], bookmarkAccess: false };
+      if (generation !== this.generation) throw new WorkbenchError("timeout");
+      const bookmarks = [];
+      const seen = new Set();
+      for (const node of nodes) {
+        const item = bookmarkSummary(node);
+        if (item && !seen.has(item.id)) { bookmarks.push(item); seen.add(item.id); }
+        if (bookmarks.length === 30) break;
+      }
+      return { ok: true, bookmarks, bookmarkAccess: true };
+    } catch (error) {
+      if (!await this.access()) return { ok: false, error: "bookmarkPermission", bookmarks: [], bookmarkAccess: false };
+      if (error instanceof WorkbenchError) throw error;
+      throw new WorkbenchError("failed");
+    }
+  }
+
+  async open({ bookmarkID, expiresAt }, { signal } = {}) {
+    if (!validBookmarkID(bookmarkID)) throw new WorkbenchError("invalidMessage");
+    const startedAt = this.now();
+    if (!Number.isFinite(expiresAt) || expiresAt <= startedAt || expiresAt > startedAt + 10_000) throw new WorkbenchError("timeout");
+    if (this.busy) throw new WorkbenchError("busy");
+    this.busy = true;
+    const generation = this.generation;
+    const deadline = Math.min(expiresAt, startedAt + this.timeoutMS);
+    const check = () => {
+      if (signal?.aborted || generation !== this.generation || this.now() >= deadline) throw new WorkbenchError("timeout");
+    };
+    try {
+      check();
+      if (!await this.access()) throw new WorkbenchError("bookmarkPermission");
+      check();
+      let nodes;
+      try { nodes = await this.api.bookmarks.get(bookmarkID); } catch { throw new WorkbenchError("bookmarkMissing"); }
+      check();
+      if (!Array.isArray(nodes) || nodes.length !== 1 || nodes[0].id !== bookmarkID) throw new WorkbenchError("bookmarkMissing");
+      bookmarkURL(nodes[0].url);
+      const originalURL = nodes[0].url;
+      if (!await this.access()) throw new WorkbenchError("bookmarkPermission");
+      check();
+      // A bookmark opens only in a newly created tab of this profile. No host
+      // access is requested and no existing tab is navigated or repurposed.
+      const tab = await this.api.tabs.create({ url: originalURL, active: true });
+      check();
+      if (!Number.isInteger(tab.id) || !Number.isInteger(tab.windowId) || tab.incognito) throw new WorkbenchError("failed");
+      const window = await this.api.windows.get(tab.windowId);
+      check();
+      if (window.incognito) throw new WorkbenchError("failed");
+      await this.api.windows.update(tab.windowId, window.state === "minimized"
+        ? { focused: true, state: "normal" } : { focused: true });
+      check();
+      const verifiedTab = await this.api.tabs.get(tab.id);
+      check();
+      const verifiedWindow = await this.api.windows.get(tab.windowId);
+      check();
+      if (!verifiedTab.active || verifiedTab.incognito || verifiedTab.windowId !== tab.windowId
+          || !verifiedWindow.focused || verifiedWindow.incognito) throw new WorkbenchError("failed");
+      if (!await this.access()) throw new WorkbenchError("bookmarkPermission");
+      check();
+      // We deliberately do not read URL/title after opening: bookmarks need
+      // no host grant, and focus is not a claim of page or account readiness.
+      return { ok: true, status: "opened" };
+    } catch (error) {
+      if (error instanceof WorkbenchError) throw error;
+      throw new WorkbenchError("failed");
+    } finally { this.busy = false; }
+  }
+}
diff --git a/BrowserExtension/profile-focus.js b/BrowserExtension/profile-focus.js
new file mode 100644
index 0000000..d83b005
--- /dev/null
+++ b/BrowserExtension/profile-focus.js
@@ -0,0 +1,42 @@
+// Reports only this connected profile's verified window-focus state. There is
+// no tab, title, URL, content or history field in this event.
+export class ProfileFocusReporter {
+  constructor(api, { enabled, send, now = Date.now }) {
+    this.api = api;
+    this.enabled = enabled;
+    this.send = send;
+    this.now = now;
+    this.generation = 0;
+    this.last = null;
+  }
+
+  reset() { this.generation++; this.last = null; }
+
+  async observe(eventWindowID) {
+    const generation = ++this.generation;
+    if (!this.enabled()) return;
+    try {
+      const windows = await this.api.windows.getAll({ populate: false, windowTypes: ["normal", "popup"] });
+      if (generation !== this.generation || !this.enabled()) return;
+      if (windows.length === 0) {
+        if (this.last !== false && this.send({ active: false, observedAt: this.now() }) !== false) this.last = false;
+        return;
+      }
+      const last = await this.api.windows.getLastFocused({ populate: false, windowTypes: ["normal", "popup"] });
+      if (generation !== this.generation || !this.enabled()) return;
+      const focused = windows.filter(window => window.focused && !window.incognito);
+      let active;
+      if (focused.length === 1 && last?.focused && !last.incognito && last.id === focused[0].id) {
+        if (eventWindowID !== undefined && eventWindowID !== last.id) return;
+        const verified = await this.api.windows.get(last.id, { populate: false });
+        if (generation !== this.generation || !this.enabled() || !verified.focused || verified.incognito) return;
+        active = true;
+      } else if (focused.length === 0 && (!last?.focused || last.incognito || !windows.some(window => window.id === last.id))) {
+        active = false;
+      } else { return; }
+      if (generation !== this.generation || !this.enabled() || this.last === active) return;
+      const observedAt = this.now();
+      if (this.send({ active, observedAt }) !== false) this.last = active;
+    } catch { /* A reliable next focus event will resample; never guess focus. */ }
+  }
+}
diff --git a/BrowserExtension/tests/bookmarks.test.js b/BrowserExtension/tests/bookmarks.test.js
new file mode 100644
index 0000000..779e319
--- /dev/null
+++ b/BrowserExtension/tests/bookmarks.test.js
@@ -0,0 +1,168 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { BookmarkController, bookmarkSummary, bookmarkURL } from "../bookmarks.js";
+
+const URL = "https://apps.example.test/start?tenant=synthetic#manager";
+const BOOKMARK = { id: "42", title: "Manager app", url: URL };
+function fixture() {
+  const calls = [];
+  let allowed = true;
+  let nodes = [{ ...BOOKMARK }];
+  const tab = { id: 9, windowId: 4, active: true, incognito: false };
+  const window = { id: 4, focused: false, incognito: false, state: "normal" };
+  const api = {
+    permissions: { contains: async value => { calls.push(["permission", value]); return allowed; } },
+    bookmarks: {
+      search: async query => { calls.push(["search", query]); return nodes; },
+      getRecent: async count => { calls.push(["recent", count]); return nodes; },
+      get: async id => { calls.push(["getBookmark", id]); return nodes.filter(node => node.id === id); },
+    },
+    tabs: {
+      create: async value => { calls.push(["create", value]); return { ...tab }; },
+      get: async id => { calls.push(["getTab", id]); return { ...tab }; },
+    },
+    windows: {
+      get: async id => { calls.push(["getWindow", id]); return { ...window }; },
+      update: async (id, value) => { calls.push(["focusWindow", id, value]); Object.assign(window, value); return { ...window }; },
+    },
+  };
+  return { api, calls, tab, window, setAccess: value => { allowed = value; }, setNodes: value => { nodes = value; } };
+}
+const request = { bookmarkID: "42", expiresAt: 9_000 };
+
+test("bookmark metadata never carries original URL, query, fragment or tree fields", () => {
+  assert.deepEqual(bookmarkSummary({ ...BOOKMARK, parentId: "1", dateAdded: 5 }), { id: "42", title: "Manager app", host: "apps.example.test" });
+  assert.equal(bookmarkSummary({ ...BOOKMARK, title: URL }).title, "apps.example.test");
+  assert.equal(bookmarkSummary({ ...BOOKMARK, title: `Go ${URL}` }).title, "Go apps.example.test");
+});
+
+test("audience labels remove control/bidi characters and stay within 80 code points", () => {
+  assert.equal(bookmarkSummary({ ...BOOKMARK, title: " \u202eManager\napp\t " }).title, "Manager app");
+  assert.equal([...bookmarkSummary({ ...BOOKMARK, title: "😀".repeat(100) }).title].length, 80);
+  assert.equal(bookmarkSummary({ ...BOOKMARK, title: "" }).title, "apps.example.test");
+});
+
+for (const value of ["javascript:alert(1)", "file:///tmp/a", "data:text/html,x", "customapp://open", "chrome://settings", "https://user:password@example.test/", "https://@example.test/", "https:///example.test/", "https://example.test/\n", "https://example.test\\path", "https://example.test/" + "😀".repeat(1100)]) {
+  test(`reject unsafe bookmark ${value.slice(0, 42)}`, () => {
+    assert.throws(() => bookmarkURL(value), { code: "bookmarkURL" });
+    assert.equal(bookmarkSummary({ ...BOOKMARK, url: value }), null);
+  });
+}
+
+test("bookmark validation preserves meaningful query and fragment in Chrome", () => {
+  assert.equal(bookmarkURL(URL).href, URL);
+  assert.equal(bookmarkSummary({ id: "folder", title: "Folder" }), null);
+});
+
+test("permission denial returns explicit no-access state without reading bookmarks", async () => {
+  const f = fixture();
+  f.setAccess(false);
+  assert.deepEqual(await new BookmarkController(f.api).search("Manager"), { ok: false, error: "bookmarkPermission", bookmarks: [], bookmarkAccess: false });
+  assert.deepEqual(f.calls.map(call => call[0]), ["permission"]);
+});
+
+test("empty query reads at most 30 recent bookmarks; search returns max30 safe unique summaries", async () => {
+  const f = fixture();
+  f.setNodes(Array.from({ length: 50 }, (_, id) => ({ ...BOOKMARK, id: String(id) })));
+  const controller = new BookmarkController(f.api);
+  assert.equal((await controller.search()).bookmarks.length, 30);
+  assert.deepEqual(f.calls.find(call => call[0] === "recent"), ["recent", 30]);
+  assert.equal((await controller.search(" Manager ")).bookmarks.length, 30);
+  assert.deepEqual(f.calls.find(call => call[0] === "search"), ["search", { query: "Manager" }]);
+});
+
+test("revocation while search is pending discards results", async () => {
+  const f = fixture();
+  f.api.bookmarks.search = async () => { f.setAccess(false); return [BOOKMARK]; };
+  const result = await new BookmarkController(f.api).search("Manager");
+  assert.equal(result.bookmarkAccess, false);
+  assert.deepEqual(result.bookmarks, []);
+});
+
+test("cancellation while search is pending cannot deliver stale summaries", async () => {
+  const f = fixture();
+  const controller = new BookmarkController(f.api);
+  f.api.bookmarks.search = async () => { controller.cancel(); return [BOOKMARK]; };
+  await assert.rejects(controller.search("Manager"), { code: "timeout" });
+});
+
+test("opening resolves exact bookmark ID locally and creates one tab with its complete original URL", async () => {
+  const f = fixture();
+  const result = await new BookmarkController(f.api, { now: () => 1_000 }).open(request);
+  assert.deepEqual(result, { ok: true, status: "opened" });
+  assert.deepEqual(f.calls.find(call => call[0] === "getBookmark"), ["getBookmark", "42"]);
+  assert.deepEqual(f.calls.find(call => call[0] === "create"), ["create", { url: URL, active: true }]);
+  assert.equal(f.calls.some(call => ["search", "recent"].includes(call[0])), false);
+  for (const [, value] of f.calls.filter(call => call[0] === "permission")) assert.deepEqual(value, { permissions: ["bookmarks"] });
+});
+
+test("wrong ID, missing bookmark or folder cannot be opened", async () => {
+  for (const nodes of [[], [{ ...BOOKMARK, id: "wrong" }], [{ ...BOOKMARK, url: undefined }]]) {
+    const f = fixture();
+    f.api.bookmarks.get = async () => nodes;
+    await assert.rejects(new BookmarkController(f.api, { now: () => 1_000 }).open(request));
+    assert.equal(f.calls.some(call => call[0] === "create"), false);
+  }
+});
+
+test("revocation after exact-ID lookup prevents opening", async () => {
+  const f = fixture();
+  f.api.bookmarks.get = async () => { f.setAccess(false); return [BOOKMARK]; };
+  await assert.rejects(new BookmarkController(f.api, { now: () => 1_000 }).open(request), { code: "bookmarkPermission" });
+  assert.equal(f.calls.some(call => call[0] === "create"), false);
+});
+
+test("expired or unbounded bookmark commands never read or open", async () => {
+  for (const expiresAt of [undefined, 1_000, 999, 11_001, NaN]) {
+    const f = fixture();
+    await assert.rejects(new BookmarkController(f.api, { now: () => 1_000 }).open({ ...request, expiresAt }), { code: "timeout" });
+    assert.equal(f.calls.length, 0);
+  }
+});
+
+test("deadline expiry, disconnect cancellation and abort between lookup and create prevent opening", async () => {
+  for (const mode of ["time", "cancel", "abort"]) {
+    const f = fixture();
+    let now = 1_000;
+    const controller = new BookmarkController(f.api, { now: () => now });
+    const abort = new AbortController();
+    f.api.bookmarks.get = async () => {
+      if (mode === "time") now = 10_000;
+      if (mode === "cancel") controller.cancel();
+      if (mode === "abort") abort.abort();
+      return [BOOKMARK];
+    };
+    await assert.rejects(controller.open(request, { signal: abort.signal }), { code: "timeout" });
+    assert.equal(f.calls.some(call => call[0] === "create"), false);
+  }
+});
+
+test("concurrent bookmark opens do not create duplicates", async () => {
+  const f = fixture();
+  let resume;
+  f.api.bookmarks.get = () => new Promise(resolve => { resume = resolve; });
+  const controller = new BookmarkController(f.api, { now: () => 1_000 });
+  const first = controller.open(request);
+  await Promise.resolve();
+  await assert.rejects(controller.open(request), { code: "busy" });
+  resume([BOOKMARK]);
+  await first;
+  assert.equal(f.calls.filter(call => call[0] === "create").length, 1);
+});
+
+test("failure to verify focus or cancellation after create is never reported as successful", async () => {
+  for (const mode of ["focus", "cancel"]) {
+    const f = fixture();
+    const controller = new BookmarkController(f.api, { now: () => 1_000 });
+    f.api.windows.update = async () => { if (mode === "cancel") controller.cancel(); };
+    await assert.rejects(controller.open(request));
+    assert.equal(f.calls.filter(call => call[0] === "create").length, 1);
+  }
+});
+
+test("minimized bookmark window restores without changing an ordinary window's state", async () => {
+  const f = fixture();
+  f.window.state = "minimized";
+  await new BookmarkController(f.api, { now: () => 1_000 }).open(request);
+  assert.deepEqual(f.calls.find(call => call[0] === "focusWindow")[2], { focused: true, state: "normal" });
+});
diff --git a/BrowserExtension/tests/profile-focus.test.js b/BrowserExtension/tests/profile-focus.test.js
new file mode 100644
index 0000000..8573794
--- /dev/null
+++ b/BrowserExtension/tests/profile-focus.test.js
@@ -0,0 +1,111 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { ProfileFocusReporter } from "../profile-focus.js";
+
+function fixture() {
+  let enabled = true;
+  const own = { id: 1, focused: true, incognito: false };
+  let windows = [own];
+  let last = own;
+  const sent = [];
+  const calls = [];
+  const api = { windows: {
+    getAll: async options => { calls.push(["all", options]); return structuredClone(windows); },
+    getLastFocused: async options => { calls.push(["last", options]); return { ...last }; },
+    get: async (id, options) => { calls.push(["get", id, options]); return { ...own }; },
+  } };
+  const reporter = new ProfileFocusReporter(api, { enabled: () => enabled, send: value => sent.push(value), now: () => 123_456 });
+  return { api, reporter, own, sent, calls, setEnabled: value => { enabled = value; },
+    setWindows: value => { windows = value; }, setLast: value => { last = value; } };
+}
+
+test("advertised capability is required before reading windows or sending profile focus", async () => {
+  const f = fixture();
+  f.setEnabled(false);
+  await f.reporter.observe();
+  assert.equal(f.calls.length, 0);
+  assert.equal(f.sent.length, 0);
+});
+
+test("initial focus uses consistent getAll/lastFocused/get and sends only activity and time", async () => {
+  const f = fixture();
+  await f.reporter.observe();
+  assert.deepEqual(f.sent, [{ active: true, observedAt: 123_456 }]);
+  assert.deepEqual(f.calls.map(call => call[0]), ["all", "last", "get"]);
+  assert.equal(f.calls[0][1].populate, false);
+  await f.reporter.observe(1);
+  assert.equal(f.sent.length, 1);
+});
+
+test("reliable blur sends false for only this connection, without profile or tab identifiers", async () => {
+  const f = fixture();
+  await f.reporter.observe();
+  f.own.focused = false;
+  await f.reporter.observe(-1);
+  assert.deepEqual(f.sent.at(-1), { active: false, observedAt: 123_456 });
+});
+
+test("no windows clears this profile even if lastFocused API would be unavailable", async () => {
+  const f = fixture();
+  f.setWindows([]);
+  f.api.windows.getLastFocused = async () => { throw new Error("No windows"); };
+  await f.reporter.observe(-1);
+  assert.deepEqual(f.sent, [{ active: false, observedAt: 123_456 }]);
+});
+
+test("incognito and a foreign last-focused window never activate this profile", async () => {
+  for (const mode of ["incognito", "foreign"]) {
+    const f = fixture();
+    if (mode === "incognito") f.own.incognito = true;
+    else f.setLast({ id: 2, focused: true, incognito: false });
+    await f.reporter.observe();
+    assert.equal(f.sent.some(value => value.active), false);
+  }
+});
+
+test("inconsistent event/window reads are ignored", async () => {
+  const f = fixture();
+  await f.reporter.observe(-1);
+  assert.equal(f.sent.length, 0);
+  f.setWindows([f.own, { id: 2, focused: true, incognito: false }]);
+  await f.reporter.observe();
+  assert.equal(f.sent.length, 0);
+});
+
+test("focus changed during the verification read cannot produce a stale active event", async () => {
+  const f = fixture();
+  f.api.windows.get = async () => ({ ...f.own, focused: false });
+  await f.reporter.observe(1);
+  assert.equal(f.sent.length, 0);
+});
+
+test("late async result from an old focus event cannot overwrite a newer blur", async () => {
+  const f = fixture();
+  let resume;
+  const getAll = f.api.windows.getAll;
+  f.api.windows.getAll = () => new Promise(resolve => { resume = resolve; });
+  const old = f.reporter.observe(1);
+  f.api.windows.getAll = getAll;
+  f.own.focused = false;
+  await f.reporter.observe(-1);
+  resume([{ id: 1, focused: true, incognito: false }]);
+  await old;
+  assert.deepEqual(f.sent, [{ active: false, observedAt: 123_456 }]);
+});
+
+test("disconnect/reset invalidates pending focus work and reconnect can send initial state", async () => {
+  const f = fixture();
+  f.api.windows.getLastFocused = async () => { f.reporter.reset(); return { ...f.own }; };
+  await f.reporter.observe();
+  assert.equal(f.sent.length, 0);
+  f.api.windows.getLastFocused = async () => ({ ...f.own });
+  await f.reporter.observe();
+  assert.equal(f.sent.length, 1);
+});
+
+test("API failures never guess a profile's focus state", async () => {
+  const f = fixture();
+  f.api.windows.getAll = async () => { throw new Error("private diagnostics"); };
+  await f.reporter.observe();
+  assert.equal(f.sent.length, 0);
+});
diff --git a/Sources/LocalVoice/PresenterPreferences.swift b/Sources/LocalVoice/PresenterPreferences.swift
new file mode 100644
index 0000000..3d307fa
--- /dev/null
+++ b/Sources/LocalVoice/PresenterPreferences.swift
@@ -0,0 +1,263 @@
+import AppKit
+import Combine
+import PresenterKit
+import UniformTypeIdentifiers
+
+/// Configuration for this Mac's paired Chrome installation; never portable state.
+struct PresenterProfilePreference: Identifiable, Codable, Equatable {
+    var id: UUID
+    var name: String
+    var personaID: UUID? = nil
+    var overlayEnabled = false
+    var notes = ""
+}
+
+/// Only a native file-panel selection can create an application shortcut.
+struct PresenterAppShortcut: Identifiable, Codable, Equatable {
+    var id: UUID
+    var name: String
+    var bundleID: String
+    var bookmarkData: Data
+}
+
+private struct PresenterPreferencesDocument: Codable {
+    var version = 1
+    var profiles: [PresenterProfilePreference] = []
+    var appShortcuts: [PresenterAppShortcut] = []
+    var overlayFollowingEnabled = false
+}
+
+@MainActor
+final class PresenterPreferences: ObservableObject {
+    static let key = "browser.presenterPreferences.v1"
+    @Published private(set) var profiles: [PresenterProfilePreference] = []
+    @Published private(set) var appShortcuts: [PresenterAppShortcut] = []
+    @Published private(set) var error: String?
+    @Published private(set) var overlayFollowingEnabled = false
+
+    private let defaults: UserDefaults
+    private var savedData: Data?
+    private var savingDisabled = false
+    private static let maximumDocumentBytes = 2 * 1024 * 1024
+
+    init(defaults: UserDefaults = .standard) {
+        self.defaults = defaults
+        guard let stored = defaults.object(forKey: Self.key) else { return }
+        guard let data = stored as? Data, data.count <= Self.maximumDocumentBytes,
+              let document = try? JSONDecoder().decode(PresenterPreferencesDocument.self, from: data) else {
+            blockSaving("Presenter settings could not be read. The saved data is unchanged; restore a known-good copy before editing.")
+            return
+        }
+        guard document.version == 1 else {
+            blockSaving("This Workbench version cannot read the saved presenter settings. Update Workbench before editing; the saved data is unchanged.")
+            return
+        }
+        guard Self.valid(document) else {
+            blockSaving("Presenter settings contain invalid entries. The saved data is unchanged; restore a known-good copy before editing.")
+            return
+        }
+        savedData = data
+        apply(document)
+    }
+
+    @discardableResult
+    func rememberProfile(id: UUID, name: String) -> Bool {
+        guard unchanged() else { return false }
+        var proposed = document
+        if let index = proposed.profiles.firstIndex(where: { $0.id == id }) {
+            proposed.profiles[index].name = name
+        } else {
+            guard proposed.profiles.count < 12 else { error = "Up to 12 Chrome profiles can have presenter settings on this Mac."; return false }
+            proposed.profiles.append(PresenterProfilePreference(id: id, name: name))
+        }
+        return save(proposed)
+    }
+
+    @discardableResult
+    func updateProfile(id: UUID, personaID: UUID?, overlayEnabled: Bool, notes: String) -> Bool {
+        guard unchanged() else { return false }
+        var proposed = document
+        guard let index = proposed.profiles.firstIndex(where: { $0.id == id }) else {
+            error = "Connect this Chrome profile before changing its presenter settings."; return false
+        }
+        guard notes.count <= 10_000 else { error = "Keep presenter notes to 10,000 characters or fewer."; return false }
+        guard !overlayEnabled || personaID != nil else { error = "Choose a persona before enabling its overlay."; return false }
+        proposed.profiles[index].personaID = personaID
+        proposed.profiles[index].overlayEnabled = overlayEnabled
+        proposed.profiles[index].notes = notes
+        return save(proposed)
+    }
+
+    @discardableResult
+    func setOverlayFollowingEnabled(_ enabled: Bool) -> Bool {
+        var proposed = document
+        proposed.overlayFollowingEnabled = enabled
+        return save(proposed)
+    }
+
+    func chooseApplication() {
+        guard unchanged() else { return }
+        let panel = NSOpenPanel()
+        panel.title = "Add a Mac application"
+        panel.message = "Choose an application to open from Switch to. Its shortcut stays on this Mac."
+        panel.prompt = "Add application"
+        panel.allowedContentTypes = [.applicationBundle]
+        panel.canChooseFiles = true
+        panel.canChooseDirectories = false
+        panel.allowsMultipleSelection = false
+        panel.treatsFilePackagesAsDirectories = false
+        panel.directoryURL = URL(fileURLWithPath: "/Applications", isDirectory: true)
+        panel.begin { [weak self] response in
+            guard response == .OK, let url = panel.url else { return }
+            Task { @MainActor in self?.rememberApplication(at: url) }
+        }
+    }
+
+    @discardableResult
+    func removeApplication(id: UUID) -> Bool {
+        guard unchanged() else { return false }
+        var proposed = document
+        guard proposed.appShortcuts.contains(where: { $0.id == id }) else {
+            error = "This application shortcut is no longer saved."; return false
+        }
+        proposed.appShortcuts.removeAll { $0.id == id }
+        return save(proposed)
+    }
+
+    /// Call only from an explicit user action. No arguments, scripts or fallback app.
+    func launchApplication(id: UUID) async -> Bool {
+        guard unchanged() else { return false }
+        guard let shortcut = appShortcuts.first(where: { $0.id == id }) else {
+            error = "This application shortcut is no longer saved."; return false
+        }
+        do {
+            var stale = false
+            let url = try URL(resolvingBookmarkData: shortcut.bookmarkData, options: [.withSecurityScope, .withoutUI],
+                              relativeTo: nil, bookmarkDataIsStale: &stale)
+            let access = url.startAccessingSecurityScopedResource()
+            defer { if access { url.stopAccessingSecurityScopedResource() } }
+            guard !Self.isWorkbench(shortcut.bundleID), Self.applicationBundleID(at: url) == shortcut.bundleID else {
+                error = "The saved application is missing or has changed. Remove this shortcut and choose the application again."; return false
+            }
+            if stale {
+                let bookmark = try Self.bookmark(for: url)
+                var proposed = document
+                guard let index = proposed.appShortcuts.firstIndex(where: { $0.id == id }) else { return false }
+                proposed.appShortcuts[index].bookmarkData = bookmark
+                guard save(proposed) else { return false }
+            }
+            let configuration = NSWorkspace.OpenConfiguration()
+            configuration.activates = true
+            configuration.createsNewApplicationInstance = false
+            configuration.allowsRunningApplicationSubstitution = false
+            let application = try await NSWorkspace.shared.openApplication(at: url, configuration: configuration)
+            guard application.bundleIdentifier == shortcut.bundleID else {
+                error = "Workbench could not confirm the chosen application opened. Choose the application again."; return false
+            }
+            error = nil
+            return true
+        } catch {
+            self.error = "Workbench could not open the saved application. Choose it again if it moved or its access changed."
+            return false
+        }
+    }
+
+    private func rememberApplication(at url: URL) {
+        guard unchanged() else { return }
+        let access = url.startAccessingSecurityScopedResource()
+        defer { if access { url.stopAccessingSecurityScopedResource() } }
+        guard let bundleID = Self.applicationBundleID(at: url) else {
+            error = "Choose a Mac application bundle ending in .app."; return
+        }
+        guard !Self.isWorkbench(bundleID) else { error = "Choose an application other than Workbench."; return }
+        do {
+            var proposed = document
+            let bookmark = try Self.bookmark(for: url)
+            if let index = proposed.appShortcuts.firstIndex(where: { $0.bundleID == bundleID }) {
+                proposed.appShortcuts[index].bookmarkData = bookmark
+            } else {
+                guard proposed.appShortcuts.count < 12 else { error = "Up to 12 application shortcuts can be saved on this Mac."; return }
+                let name = url.deletingPathExtension().lastPathComponent
+                proposed.appShortcuts.append(PresenterAppShortcut(id: UUID(), name: name, bundleID: bundleID, bookmarkData: bookmark))
+            }
+            _ = save(proposed)
+        } catch {
+            self.error = "Workbench could not retain access to this application. Choose the application again."
+        }
+    }
+
+    private static func applicationBundleID(at url: URL) -> String? {
+        guard url.isFileURL, url.pathExtension.lowercased() == "app",
+              (try? url.resourceValues(forKeys: [.isDirectoryKey]).isDirectory) == true,
+              let identifier = Bundle(url: url)?.bundleIdentifier, validBundleID(identifier) else { return nil }
+        return identifier
+    }
+
+    private static func bookmark(for url: URL) throws -> Data {
+        try url.bookmarkData(options: [.withSecurityScope, .securityScopeAllowOnlyReadAccess],
+                             includingResourceValuesForKeys: nil, relativeTo: nil)
+    }
+
+    private static func validBundleID(_ identifier: String) -> Bool {
+        !identifier.isEmpty && identifier.utf8.count <= 255
+            && identifier.unicodeScalars.allSatisfy { CharacterSet(charactersIn: "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789.-").contains($0) }
+    }
+
+    private static func isWorkbench(_ identifier: String) -> Bool {
+        identifier == Bundle.main.bundleIdentifier || ["com.ethdawg.workbench", "com.ethdawg.workbench.preview"].contains(identifier)
+    }
+
+    private var document: PresenterPreferencesDocument {
+        PresenterPreferencesDocument(profiles: profiles, appShortcuts: appShortcuts, overlayFollowingEnabled: overlayFollowingEnabled)
+    }
+
+    private static func valid(_ document: PresenterPreferencesDocument) -> Bool {
+        document.version == 1 && document.profiles.count <= 12 && document.appShortcuts.count <= 12
+            && Set(document.profiles.map(\.id)).count == document.profiles.count
+            && Set(document.appShortcuts.map(\.id)).count == document.appShortcuts.count
+            && Set(document.appShortcuts.map(\.bundleID)).count == document.appShortcuts.count
+            && document.profiles.allSatisfy { PresenterURL.validName($0.name) && $0.notes.count <= 10_000
+                && (!$0.overlayEnabled || $0.personaID != nil) }
+            && document.appShortcuts.allSatisfy { PresenterURL.validName($0.name) && validBundleID($0.bundleID) && !isWorkbench($0.bundleID)
+                && !$0.bookmarkData.isEmpty && $0.bookmarkData.count <= 65_536 }
+    }
+
+    private func unchanged() -> Bool {
+        guard !savingDisabled else { return false }
+        let current = defaults.object(forKey: Self.key)
+        guard (current == nil && savedData == nil) || (current as? Data != nil && current as? Data == savedData) else {
+            blockSaving("Presenter settings changed outside this window. Reopen Workbench before editing; the newer data is unchanged.")
+            return false
+        }
+        return true
+    }
+
+    private func save(_ proposed: PresenterPreferencesDocument) -> Bool {
+        guard unchanged() else { return false }
+        guard Self.valid(proposed) else { error = "Presenter settings are invalid. Use profile names up to 80 characters and notes up to 10,000 characters."; return false }
+        do {
+            let encoder = JSONEncoder(); encoder.outputFormatting = [.sortedKeys]
+            let data = try encoder.encode(proposed)
+            guard data.count <= Self.maximumDocumentBytes else { error = "Presenter settings exceed the storage limit."; return false }
+            defaults.set(data, forKey: Self.key)
+            guard defaults.data(forKey: Self.key) == data else {
+                blockSaving("Presenter settings could not be saved. Reopen Workbench before trying again."); return false
+            }
+            savedData = data
+            apply(proposed)
+            error = nil
+            return true
+        } catch {
+            self.error = "Presenter settings could not be saved. The previous settings remain available."
+            return false
+        }
+    }
+
+    private func apply(_ document: PresenterPreferencesDocument) {
+        profiles = document.profiles
+        appShortcuts = document.appShortcuts
+        overlayFollowingEnabled = document.overlayFollowingEnabled
+    }
+
+    private func blockSaving(_ explanation: String) { savingDisabled = true; error = explanation }
+}
diff --git a/Sources/LocalVoice/PresenterPreferencesChecks.swift b/Sources/LocalVoice/PresenterPreferencesChecks.swift
new file mode 100644
index 0000000..d8c0b46
--- /dev/null
+++ b/Sources/LocalVoice/PresenterPreferencesChecks.swift
@@ -0,0 +1,82 @@
+import Foundation
+
+enum PresenterPreferencesChecks {
+    @MainActor static func run() async throws {
+        let suite = "workbench.presenter.preferences.check.\(UUID().uuidString)"
+        let defaults = UserDefaults(suiteName: suite)!
+        defer { defaults.removePersistentDomain(forName: suite) }
+        var passed = 0
+        func check(_ condition: Bool, _ label: String) throws {
+            guard condition else { throw VoiceError.message("Presenter preferences check failed: \(label)") }
+            passed += 1
+            print("PASS: \(label)")
+        }
+        func reset() { defaults.removeObject(forKey: PresenterPreferences.key) }
+        func setDocument(_ value: [String: Any]) throws -> Data {
+            let data = try JSONSerialization.data(withJSONObject: value, options: [.sortedKeys])
+            defaults.set(data, forKey: PresenterPreferences.key)
+            return data
+        }
+        let model = PresenterPreferences(defaults: defaults)
+        try check(model.profiles.isEmpty && model.appShortcuts.isEmpty && !model.overlayFollowingEnabled && model.error == nil, "fresh preferences are empty and opt-in")
+        try check(defaults.object(forKey: PresenterPreferences.key) == nil, "loading defaults does not create a document")
+        let id = UUID(), persona = UUID()
+        try check(model.rememberProfile(id: id, name: "Manager"), "remember a paired profile")
+        let notes = String(repeating: "🙂", count: 10_000)
+        try check(model.updateProfile(id: id, personaID: persona, overlayEnabled: true, notes: notes), "10,000 Unicode characters are accepted")
+        try check(model.rememberProfile(id: id, name: "Manager renamed"), "reconnect can rename a profile")
+        try check(model.profiles.count == 1 && model.profiles[0].personaID == persona && model.profiles[0].overlayEnabled && model.profiles[0].notes == notes, "rename preserves configured persona, overlay and notes")
+        try check(model.setOverlayFollowingEnabled(true), "overlay following is explicitly enabled")
+        let reopened = PresenterPreferences(defaults: defaults)
+        try check(reopened.profiles == model.profiles && reopened.overlayFollowingEnabled, "preferences survive a new model instance")
+        let beforeInvalid = defaults.data(forKey: PresenterPreferences.key)!
+        try check(!reopened.updateProfile(id: id, personaID: nil, overlayEnabled: false, notes: notes + "x"), "oversized notes are rejected")
+        try check(!reopened.updateProfile(id: id, personaID: nil, overlayEnabled: true, notes: ""), "enabling an overlay requires a selected persona")
+        try check(!reopened.rememberProfile(id: id, name: "Invalid\nname"), "control characters in profile names are rejected")
+        try check(defaults.data(forKey: PresenterPreferences.key) == beforeInvalid && reopened.profiles == model.profiles, "invalid transaction preserves persisted bytes and in-memory state")
+        try check(!reopened.updateProfile(id: UUID(), personaID: nil, overlayEnabled: false, notes: "missing"), "unknown profile update is rejected")
+        for index in 1...11 { try check(reopened.rememberProfile(id: UUID(), name: "Profile \(index)"), "profile capacity \(index + 1)") }
+        let atCapacity = defaults.data(forKey: PresenterPreferences.key)!
+        try check(!reopened.rememberProfile(id: UUID(), name: "Thirteenth") && reopened.profiles.count == 12 && defaults.data(forKey: PresenterPreferences.key) == atCapacity, "thirteenth profile preserves existing settings")
+        try check(!model.setOverlayFollowingEnabled(false) && defaults.data(forKey: PresenterPreferences.key) == atCapacity, "stale model cannot overwrite newer settings")
+        reset()
+        let corrupt = Data("broken settings".utf8)
+        defaults.set(corrupt, forKey: PresenterPreferences.key)
+        let broken = PresenterPreferences(defaults: defaults)
+        try check(broken.error != nil && broken.profiles.isEmpty && !broken.overlayFollowingEnabled, "corrupt document fails closed")
+        try check(!broken.rememberProfile(id: id, name: "Ignored") && !broken.setOverlayFollowingEnabled(true) && defaults.data(forKey: PresenterPreferences.key) == corrupt, "corrupt bytes cannot be replaced by mutations")
+        reset()
+        let future = try setDocument(["version": 2, "profiles": [], "appShortcuts": [], "overlayFollowingEnabled": true])
+        let unsupported = PresenterPreferences(defaults: defaults)
+        try check(unsupported.error != nil && !unsupported.overlayFollowingEnabled && !unsupported.setOverlayFollowingEnabled(false) && defaults.data(forKey: PresenterPreferences.key) == future, "future document fails closed and is preserved")
+        reset()
+        defaults.set("not Data", forKey: PresenterPreferences.key)
+        let wrongType = PresenterPreferences(defaults: defaults)
+        try check(wrongType.error != nil && !wrongType.rememberProfile(id: id, name: "Ignored") && defaults.string(forKey: PresenterPreferences.key) == "not Data", "wrong defaults type is preserved")
+        reset()
+        let profile: [String: Any] = ["id": id.uuidString, "name": "Duplicate", "overlayEnabled": false, "notes": ""]
+        let duplicate = try setDocument(["version": 1, "profiles": [profile, profile], "appShortcuts": [], "overlayFollowingEnabled": true])
+        let invalid = PresenterPreferences(defaults: defaults)
+        try check(invalid.error != nil && invalid.profiles.isEmpty && !invalid.setOverlayFollowingEnabled(true) && defaults.data(forKey: PresenterPreferences.key) == duplicate, "duplicate identity invalidates document without partial loading")
+        reset()
+        var missingPersona = profile
+        missingPersona["overlayEnabled"] = true
+        let invalidOverlay = try setDocument(["version": 1, "profiles": [missingPersona], "appShortcuts": [], "overlayFollowingEnabled": true])
+        let invalidOverlayModel = PresenterPreferences(defaults: defaults)
+        try check(invalidOverlayModel.error != nil && invalidOverlayModel.profiles.isEmpty && !invalidOverlayModel.setOverlayFollowingEnabled(false) && defaults.data(forKey: PresenterPreferences.key) == invalidOverlay, "saved overlay without a persona fails closed and is preserved")
+        reset()
+        let beforeExternal = PresenterPreferences(defaults: defaults)
+        defaults.set(corrupt, forKey: PresenterPreferences.key)
+        try check(!beforeExternal.rememberProfile(id: id, name: "Ignored") && defaults.data(forKey: PresenterPreferences.key) == corrupt, "new external corruption is preserved")
+        reset()
+        let selfShortcut: [String: Any] = ["id": UUID().uuidString, "name": "Workbench", "bundleID": "com.ethdawg.workbench", "bookmarkData": Data([1]).base64EncodedString()]
+        _ = try setDocument(["version": 1, "profiles": [], "appShortcuts": [selfShortcut], "overlayFollowingEnabled": false])
+        let selfModel = PresenterPreferences(defaults: defaults)
+        try check(selfModel.error != nil && selfModel.appShortcuts.isEmpty, "Workbench application shortcut is rejected before use")
+        reset()
+        let absent = PresenterPreferences(defaults: defaults)
+        let launched = await absent.launchApplication(id: UUID())
+        try check(!launched && absent.error != nil && defaults.object(forKey: PresenterPreferences.key) == nil, "missing app action fails without changing defaults or launching an app")
+        print("PRESENTER_PREFERENCES_OK: \(passed) checks")
+    }
+}
diff --git a/Sources/LocalVoice/PresenterProfileCoordinator.swift b/Sources/LocalVoice/PresenterProfileCoordinator.swift
new file mode 100644
index 0000000..de2089a
--- /dev/null
+++ b/Sources/LocalVoice/PresenterProfileCoordinator.swift
@@ -0,0 +1,49 @@
+import AppKit
+import Combine
+import StageKit
+
+/// Follows only the profile authenticated by the local bridge. No window titles,
+/// browser history or accessibility inspection are used to infer identity.
+@MainActor
+final class PresenterProfileCoordinator {
+    private let model: PresenterModel
+    private let stage: StageKitController
+    private var observations = Set<AnyCancellable>()
+    private var workspaceObserver: NSObjectProtocol?
+    private var shown: String?
+    init(model: PresenterModel, stage: StageKitController) {
+        self.model = model; self.stage = stage
+        model.personaChoices = stage.profileOverlayChoices
+        model.onProfileFocus = { [weak self] in self?.refresh() }
+        model.preferences.objectWillChange.sink { [weak self] _ in
+            Task { @MainActor in self?.refresh() }
+        }.store(in: &observations)
+        stage.objectWillChange.sink { [weak self] _ in
+            Task { @MainActor in
+                guard let self else { return }
+                self.model.personaChoices = self.stage.profileOverlayChoices
+            }
+        }.store(in: &observations)
+        workspaceObserver = NSWorkspace.shared.notificationCenter.addObserver(
+            forName: NSWorkspace.didActivateApplicationNotification, object: nil, queue: .main
+        ) { [weak self] _ in Task { @MainActor in self?.refresh() } }
+    }
+    func refresh() {
+        let browser = NSWorkspace.shared.frontmostApplication?.bundleIdentifier
+        guard ["com.google.Chrome", "com.google.Chrome.beta", "com.google.Chrome.dev", "com.google.Chrome.canary", "com.google.chrome.for.testing"].contains(browser ?? ""),
+              model.preferences.overlayFollowingEnabled, model.mayActivate?() != false,
+              let id = model.activeProfileID,
+              let profile = model.preferences.profiles.first(where: { $0.id == id }),
+              profile.overlayEnabled, let persona = profile.personaID else { hide(); return }
+        let key = id.uuidString + persona.uuidString + profile.name
+        guard shown != key else { return }
+        do { try stage.showProfileOverlay(personaID: persona, profileName: profile.name); shown = key }
+        catch { hide(); model.message = error.localizedDescription }
+    }
+    func hide() { shown = nil; stage.hideProfileOverlay() }
+    func shutdown() {
+        hide(); model.onProfileFocus = nil; observations.removeAll()
+        if let workspaceObserver { NSWorkspace.shared.notificationCenter.removeObserver(workspaceObserver) }
+        workspaceObserver = nil
+    }
+}
diff --git a/Sources/StageKit/ProfilePersonaOverlay.swift b/Sources/StageKit/ProfilePersonaOverlay.swift
new file mode 100644
index 0000000..b7dc8ae
--- /dev/null
+++ b/Sources/StageKit/ProfilePersonaOverlay.swift
@@ -0,0 +1,93 @@
+import AppKit
+import Combine
+
+/// A saved artwork choice. Browser bindings remain in the host's local settings;
+/// StageKit never reads Chrome profiles or changes the persona library for them.
+public struct ProfilePersonaChoice: Identifiable, Equatable {
+    public let id: UUID
+    public let name: String
+}
+
+public enum ProfilePersonaOverlayError: LocalizedError {
+    case missingPersona, invalidProfileName, unreadableArtwork
+
+    public var errorDescription: String? {
+        switch self {
+        case .missingPersona:
+            return "This Chrome profile's persona was removed. Choose another saved persona in Chrome connection settings."
+        case .invalidProfileName:
+            return "Give this Chrome profile a name of 1–80 characters without line breaks or control characters."
+        case .unreadableArtwork:
+            return "This Chrome profile's persona image is missing or unreadable. Repair it in Personas, then choose it again."
+        }
+    }
+}
+
+/// Owns only the automatic browser persona. Manual prepared sessions, their
+/// frozen images and their saved placement are independent of this window.
+/// The artwork is audience-visible; this is not a private presenter HUD.
+final class ProfilePersonaOverlayController {
+    private let library: PersonaLibrary
+    private let makePanel: () -> any PersonaSessionDisplaying
+    private var panel: (any PersonaSessionDisplaying)?
+    private var itemsObservation: AnyCancellable?
+    // A compact top-right indicator avoids the ordinary manual persona's
+    // bottom-right default without moving any prepared overlay.
+    private var placement = PersonaOverlayState(x: 0.98, y: 0.98, width: 0.10, locked: true)
+    private(set) var personaID: UUID?
+
+    init(library: PersonaLibrary,
+         makePanel: @escaping () -> any PersonaSessionDisplaying = {
+             PersonaOverlayController(lockedAccessibilityHelp: "Chrome profile persona. Change or turn it off in Workbench Chrome connection settings.")
+         }) {
+        self.library = library; self.makePanel = makePanel
+        itemsObservation = library.$items.sink { [weak self] items in
+            guard let self, let personaID = self.personaID else { return }
+            if !items.contains(where: { $0.id == personaID }) { self.hide() }
+        }
+    }
+
+    var choices: [ProfilePersonaChoice] {
+        library.items.map { ProfilePersonaChoice(id: $0.id, name: $0.name) }
+    }
+
+    /// Resolve the exact UUID afresh before showing. A missing target must never
+    /// leave the previous profile's artwork on screen or choose a replacement.
+    func show(personaID: UUID, profileName: String) throws {
+        do {
+            let name = profileName.trimmingCharacters(in: .whitespacesAndNewlines)
+            guard !name.isEmpty, name.count <= 80,
+                  profileName.unicodeScalars.allSatisfy({ !CharacterSet.controlCharacters.contains($0) })
+            else { throw ProfilePersonaOverlayError.invalidProfileName }
+            let persona = try library.personaForProfileOverlay(personaID)
+            guard let image = library.renderedImage(for: persona),
+                  let pixels = image.cgImage(forProposedRect: nil, context: nil, hints: nil),
+                  pixels.width > 0, pixels.height > 0,
+                  pixels.bytesPerRow * pixels.height <= PersonaSessionController.maximumImageBytes
+            else { throw ProfilePersonaOverlayError.unreadableArtwork }
+            let display: any PersonaSessionDisplaying
+            if let panel { display = panel }
+            else {
+                display = makePanel(); panel = display
+                display.onPlacementChange = { [weak self] value in
+                    guard let self, let validated = try? value.validated() else { return }
+                    self.placement = validated; self.placement.locked = true
+                }
+            }
+            // The existing renderer draws only chosen artwork. The profile name
+            // is an accessibility label, never a new label baked onto the image.
+            placement = display.show(image: image, name: "Chrome profile: \(name)", state: placement, animated: false)
+            placement.locked = true
+            self.personaID = personaID
+        } catch {
+            hide()
+            throw error
+        }
+    }
+
+    func hide() { panel?.hide(); personaID = nil }
+
+    func shutdown() {
+        hide(); panel?.shutdown(); panel = nil
+    }
+}
diff --git a/Tests/StageKitLegacy/ProfilePersonaOverlayTests.swift b/Tests/StageKitLegacy/ProfilePersonaOverlayTests.swift
new file mode 100644
index 0000000..133a44a
--- /dev/null
+++ b/Tests/StageKitLegacy/ProfilePersonaOverlayTests.swift
@@ -0,0 +1,180 @@
+import AppKit
+import ImageIO
+import UniformTypeIdentifiers
+
+final class ProfilePersonaOverlayTests {
+    private final class Display: PersonaSessionDisplaying {
+        var onPlacementChange: ((PersonaOverlayState) -> Void)?
+        var onSelection: (() -> Void)?
+        var frame: CGRect? = .zero
+        var visible = false
+        var stopped = false
+        var image: NSImage?
+        var name = ""
+        var state = PersonaOverlayState()
+        var showCount = 0
+        func show(image: NSImage, name: String, state: PersonaOverlayState, animated: Bool) -> PersonaOverlayState {
+            configure(image: image, name: name, state: state); visible = true; showCount += 1
+            self.state.screenID = 44
+            return self.state
+        }
+        func configure(image: NSImage, name: String, state: PersonaOverlayState) {
+            self.image = image; self.name = name; self.state = state
+        }
+        func hide() { visible = false }
+        func shutdown() { hide(); stopped = true; onPlacementChange = nil; onSelection = nil }
+    }
+    private final class Displays {
+        var all: [Display] = []
+        func make() -> Display { let panel = Display(); all.append(panel); return panel }
+    }
+    private struct Fixture {
+        let root: URL
+        let library: PersonaLibrary
+        let overlays: ProfilePersonaOverlayController
+        let profiles: Displays
+        let manual: Displays
+        let first: SavedPersona
+        let second: SavedPersona
+    }
+    private func image(_ color: CGColor) throws -> Data {
+        let context = CGContext(data: nil, width: 24, height: 32, bitsPerComponent: 8, bytesPerRow: 96,
+            space: CGColorSpaceCreateDeviceRGB(), bitmapInfo: CGImageAlphaInfo.premultipliedLast.rawValue)!
+        context.setFillColor(color); context.fill(CGRect(x: 1, y: 1, width: 22, height: 30))
+        let data = NSMutableData()
+        let destination = CGImageDestinationCreateWithData(data, UTType.png.identifier as CFString, 1, nil)!
+        CGImageDestinationAddImage(destination, context.makeImage()!, nil)
+        guard CGImageDestinationFinalize(destination) else { throw PersonaError.unreadableImage }
+        return data as Data
+    }
+    private func fixture() throws -> Fixture {
+        let root = FileManager.default.temporaryDirectory.appendingPathComponent("ProfilePersonaTests-" + UUID().uuidString)
+        try FileManager.default.createDirectory(at: root, withIntermediateDirectories: true)
+        let source = root.appendingPathComponent("synthetic.png"), profiles = Displays(), manual = Displays()
+        let library = PersonaLibrary(root: root, sessionPanelFactory: { manual.make() }, sessionHUDEnabled: false)
+        try image(CGColor(red: 0.8, green: 0.1, blue: 0.1, alpha: 1)).write(to: source)
+        let first = try library.addImage(source, card: PersonaCardStyle(label: "Manager"))
+        try image(CGColor(red: 0.1, green: 0.7, blue: 0.1, alpha: 1)).write(to: source)
+        let second = try library.addImage(source)
+        library.rename(first.id, name: "First saved artwork"); library.rename(second.id, name: "Second saved artwork")
+        return Fixture(root: root, library: library,
+            overlays: ProfilePersonaOverlayController(library: library, makePanel: { profiles.make() }),
+            profiles: profiles, manual: manual, first: first, second: second)
+    }
+    private func cleanup(_ fixture: Fixture) {
+        fixture.overlays.shutdown(); fixture.library.shutdown()
+        try? FileManager.default.removeItem(at: fixture.root)
+    }
+    private func files(_ root: URL) throws -> [String: Data] {
+        try Dictionary(uniqueKeysWithValues: FileManager.default.contentsOfDirectory(atPath: root.path).map {
+            ($0, try Data(contentsOf: root.appendingPathComponent($0)))
+        })
+    }
+
+    func testExactChoicesSwitchArtworkWithoutChangingLibraryOrSelection() throws {
+        let f = try fixture(); defer { cleanup(f) }
+        let before = try files(f.root), selection = f.library.selectedID
+        XCTAssertEqual(f.overlays.choices.map(\.id), [f.first.id, f.second.id])
+        XCTAssertEqual(f.overlays.choices.map(\.name), ["First saved artwork", "Second saved artwork"])
+        try f.overlays.show(personaID: f.first.id, profileName: "Manager")
+        let first = f.profiles.all[0].image!.tiffRepresentation!
+        XCTAssertEqual(f.profiles.all[0].image?.size, CGSize(width: 480, height: 600))
+        XCTAssertEqual(f.overlays.personaID, f.first.id)
+        try f.overlays.show(personaID: f.second.id, profileName: "Employee")
+        XCTAssertFalse(first == f.profiles.all[0].image!.tiffRepresentation!)
+        XCTAssertEqual(f.profiles.all[0].name, "Chrome profile: Employee")
+        for _ in 0..<20 { try f.overlays.show(personaID: f.second.id, profileName: "Employee") }
+        XCTAssertEqual(f.profiles.all.count, 1, "Repeated focus cannot accumulate windows")
+        XCTAssertTrue(f.profiles.all[0].state.locked)
+        XCTAssertEqual(f.profiles.all[0].state.x, 0.98)
+        XCTAssertEqual(f.profiles.all[0].state.y, 0.98)
+        XCTAssertEqual(f.profiles.all[0].state.width, 0.10)
+        XCTAssertEqual(f.profiles.all[0].state.screenID, 44)
+        XCTAssertEqual(f.overlays.personaID, f.second.id)
+        XCTAssertEqual(f.library.selectedID, selection)
+        XCTAssertEqual(try files(f.root), before)
+        f.overlays.hide(); XCTAssertFalse(f.profiles.all[0].visible)
+        XCTAssertEqual(f.overlays.personaID, nil)
+        try f.overlays.show(personaID: f.first.id, profileName: "Manager")
+        XCTAssertEqual(f.profiles.all.count, 1)
+    }
+
+    func testHideShutdownAndProfileSwitchPreserveManualPreparedSession() throws {
+        let f = try fixture(); defer { cleanup(f) }
+        let group = try f.library.createGroup(name: "Manual demo", members: [f.first.id, f.second.id])
+        try f.library.saveGroupLayout(group, overlays: [PersonaOverlayItem(personaID: f.first.id)], publicLabel: "Prepared")
+        try f.library.startOverlaySession(groupIDs: [group], initialGroupID: group)
+        let before = try files(f.root), instance = f.library.sessionState.instances[0].id
+        let image = f.manual.all[0].image!.tiffRepresentation!
+        try f.overlays.show(personaID: f.second.id, profileName: "Employee")
+        XCTAssertTrue(f.manual.all[0].visible); XCTAssertTrue(f.profiles.all[0].visible)
+        f.overlays.hide(); f.overlays.hide()
+        XCTAssertTrue(f.manual.all[0].visible); XCTAssertFalse(f.profiles.all[0].visible)
+        try f.overlays.show(personaID: f.first.id, profileName: "Manager")
+        f.overlays.shutdown(); f.overlays.shutdown()
+        XCTAssertTrue(f.profiles.all[0].stopped); XCTAssertFalse(f.manual.all[0].stopped)
+        XCTAssertEqual(f.library.sessionState.phase, .active)
+        XCTAssertEqual(f.library.sessionState.instances[0].id, instance)
+        XCTAssertEqual(f.manual.all[0].image!.tiffRepresentation!, image)
+        XCTAssertEqual(try files(f.root), before)
+        f.library.shutdown(); XCTAssertTrue(f.manual.all[0].stopped)
+    }
+
+    func testMissingDeletedAndInvalidArtworkFailClosedWithoutFallback() throws {
+        let f = try fixture(); defer { cleanup(f) }
+        try f.overlays.show(personaID: f.first.id, profileName: "Manager")
+        XCTAssertThrowsError(try f.overlays.show(personaID: UUID(), profileName: "Missing"))
+        XCTAssertFalse(f.profiles.all[0].visible); XCTAssertEqual(f.overlays.personaID, nil)
+        try f.overlays.show(personaID: f.first.id, profileName: "Manager")
+        f.library.remove(f.first.id)
+        XCTAssertFalse(f.profiles.all[0].visible, "Explicit removal must immediately hide the owned artwork")
+        XCTAssertThrowsError(try f.overlays.show(personaID: f.first.id, profileName: "Manager"))
+        XCTAssertTrue(FileManager.default.fileExists(atPath: f.root.appendingPathComponent(f.first.image).path))
+        try f.overlays.show(personaID: f.second.id, profileName: "Employee")
+        try Data("not an image".utf8).write(to: f.root.appendingPathComponent(f.second.image))
+        let before = try files(f.root)
+        XCTAssertThrowsError(try f.overlays.show(personaID: f.second.id, profileName: "Employee"))
+        XCTAssertFalse(f.profiles.all[0].visible)
+        XCTAssertEqual(try files(f.root), before)
+        let artwork = f.root.appendingPathComponent(f.second.image)
+        try FileManager.default.removeItem(at: artwork)
+        XCTAssertThrowsError(try f.overlays.show(personaID: f.second.id, profileName: "Employee"))
+        try FileManager.default.createSymbolicLink(at: artwork, withDestinationURL: f.root.appendingPathComponent("synthetic.png"))
+        XCTAssertThrowsError(try f.overlays.show(personaID: f.second.id, profileName: "Employee"))
+        XCTAssertFalse(f.profiles.all[0].visible)
+        XCTAssertEqual(f.profiles.all.count, 1, "Failed resolution never opens a substitute artwork window")
+    }
+
+    func testInvalidNamesAndExternallyChangedArchiveHidePreviousProfile() throws {
+        let f = try fixture(); defer { cleanup(f) }
+        let before = try files(f.root)
+        for name in ["", "  ", "Employee\nManager", String(repeating: "a", count: 81)] {
+            try f.overlays.show(personaID: f.first.id, profileName: "Manager")
+            XCTAssertThrowsError(try f.overlays.show(personaID: f.second.id, profileName: name))
+            XCTAssertFalse(f.profiles.all[0].visible)
+        }
+        XCTAssertEqual(try files(f.root), before)
+        try f.overlays.show(personaID: f.first.id, profileName: "Manager")
+        let changed = Data("{\"version\":900}".utf8), archive = f.root.appendingPathComponent("persona-library.json")
+        try changed.write(to: archive)
+        XCTAssertThrowsError(try f.overlays.show(personaID: f.second.id, profileName: "Employee"))
+        XCTAssertFalse(f.profiles.all[0].visible)
+        XCTAssertEqual(try Data(contentsOf: archive), changed)
+    }
+
+    func testReadOnlyArtworkCanShowAndLibraryChoicesFollowExplicitEdits() throws {
+        let f = try fixture(); defer { cleanup(f) }
+        let readOnly = PersonaLibrary(root: f.root, readOnlyReason: "Temporary read-only review", sessionHUDEnabled: false)
+        let displays = Displays()
+        let owner = ProfilePersonaOverlayController(library: readOnly, makePanel: { displays.make() })
+        defer { owner.shutdown(); readOnly.shutdown() }
+        let before = try files(f.root)
+        try owner.show(personaID: f.first.id, profileName: "Manager")
+        XCTAssertTrue(displays.all[0].visible)
+        XCTAssertEqual(try files(f.root), before)
+        f.library.rename(f.first.id, name: "Updated choice")
+        XCTAssertEqual(f.overlays.choices[0].name, "Updated choice")
+        XCTAssertThrowsError(try owner.show(personaID: f.first.id, profileName: "Manager"))
+        XCTAssertFalse(displays.all[0].visible)
+    }
+}
